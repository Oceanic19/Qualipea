<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg">

    <!-- soft decorative blobs -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-110dp"
        android:background="@drawable/bg_blob" />

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-120dp"
        android:layout_marginBottom="-90dp"
        android:background="@drawable/bg_blob" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="80dp">

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:cardBackgroundColor="@color/card_white"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_peanut"
                android:contentDescription="@string/app_name" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/app_name"
            android:textColor="@color/text_dark"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Spanish Peanut Quality Grading"
            android:textColor="@color/text_gray"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/rowPills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView style="@style/FeaturePill" android:text="Scan" />
            <TextView style="@style/FeaturePill" android:layout_marginStart="8dp" android:text="Grade" />
            <TextView style="@style/FeaturePill" android:layout_marginStart="8dp" android:text="Price estimate" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:stateListAnimator="@null"
            android:text="Create Account"
            android:textAllCaps="false"
            android:textColor="@color/card_white"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignIn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:text="Login"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/brand_primary"
            app:strokeWidth="1.5dp" />

        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Built for Spanish peanut farmers and traders"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>