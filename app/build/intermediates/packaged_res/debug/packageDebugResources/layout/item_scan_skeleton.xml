<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#F3E9D8"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <View android:layout_width="80dp" android:layout_height="24dp"
            android:background="@drawable/bg_skeleton" />
        <View android:layout_width="170dp" android:layout_height="12dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_skeleton" />
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="horizontal">
            <View android:layout_width="70dp" android:layout_height="22dp"
                android:background="@drawable/bg_skeleton" />
            <View android:layout_width="60dp" android:layout_height="22dp"
                android:layout_marginStart="8dp" android:background="@drawable/bg_skeleton" />
            <View android:layout_width="60dp" android:layout_height="22dp"
                android:layout_marginStart="8dp" android:background="@drawable/bg_skeleton" />
        </LinearLayout>
        <View android:layout_width="100dp" android:layout_height="14dp"
            android:layout_marginTop="14dp" android:background="@drawable/bg_skeleton" />
    </LinearLayout>
</androidx.cardview.widget.CardView>