<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/logo_peanut"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spanish Peanut Quality Grading"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <!-- Raspberry Pi status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/circle_gray"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvDeviceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking Raspberry Pi…"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Your Activity -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Activity"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- Statistics -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_stat_tile"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total scans"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStatScans"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/brand_primary"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_stat_tile"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kernels analyzed"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStatKernels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/brand_primary"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Kernel Quality -->
                    <LinearLayout
                        android:id="@+id/activityBreakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Kernel Quality"
                                android:textColor="@color/text_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All scans"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_bar_track"
                            android:clipToOutline="true"
                            android:layout_marginTop="10dp">

                            <View
                                android:id="@+id/barGood"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@color/status_good" />

                            <View
                                android:id="@+id/barDefect"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@color/delete_red" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:id="@+id/dotGood"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/dot_good"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:id="@+id/tvLegendGood"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_dark"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical|end">

                                <View
                                    android:id="@+id/dotDefect"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/dot_defect"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:id="@+id/tvLegendDefect"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_dark"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Peanut Quality Reference Guide -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardReferenceGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peanut Classes Reference Guide"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Browse sample kernel appearances for each quality category."
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Extra Class -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_tile"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Extra Class"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivExtraClass"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/logo_peanut"
                            android:contentDescription="Extra Class sample image" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnExtraPrev"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Previous"
                                android:textAllCaps="false"
                                android:textColor="@color/brand_primary"
                                android:minHeight="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                            <TextView
                                android:id="@+id/tvExtraCounter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1/4"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnExtraNext"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Next"
                                android:textAllCaps="false"
                                android:textColor="@color/brand_primary"
                                android:minHeight="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Class I -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_tile"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Class I"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivClassOne"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/broken_kernel"
                            android:contentDescription="Class I sample image" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnClassOnePrev"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Previous"
                                android:textAllCaps="false"
                                android:textColor="@color/brand_primary"
                                android:minHeight="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                            <TextView
                                android:id="@+id/tvClassOneCounter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1/4"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnClassOneNext"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Next"
                                android:textAllCaps="false"
                                android:textColor="@color/brand_primary"
                                android:minHeight="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Class II -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_tile"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Class II"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivClassTwo"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/discolored_kernel"
                            android:contentDescription="Class II sample image" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnClassTwoPrev"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Previous"
                                android:textAllCaps="false"
                                android:textColor="@color/brand_primary"
                                android:minHeight="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                            <TextView
                                android:id="@+id/tvClassTwoCounter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1/4"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnClassTwoNext"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Next"
                                android:textAllCaps="false"
                                android:textColor="@color/brand_primary"
                                android:minHeight="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Defected -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_tile"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Defected"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivDefected"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/moldy_kernel"
                            android:contentDescription="Defected sample image" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDefectedPrev"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Previous"
                                android:textAllCaps="false"
                                android:textColor="@color/brand_primary"
                                android:minHeight="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                            <TextView
                                android:id="@+id/tvDefectedCounter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1/4"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDefectedNext"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="Next"
                                android:textAllCaps="false"
                                android:textColor="@color/brand_primary"
                                android:minHeight="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Note: Images are temporary visual placeholders and are not official grading standards."
                        android:textColor="@color/text_gray"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Spacer: Reference Guide -> Recent Activity -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.35" />

            <!-- Recent Activity -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToOutline="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Activity"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="2dp" />

                    <FrameLayout
                        android:id="@+id/recentBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp">

                        <LinearLayout
                            android:id="@+id/recentScansContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/emptyRecent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:text="No recent activity yet.\nYour scans will show up here."
                            android:textColor="@color/text_gray"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAllHistory"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="View all history"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconGravity="textEnd"
                        app:iconTint="@color/brand_primary"
                        android:visibility="invisible" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Spacer: Recent Activity -> Ready To Grade -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.75" />

            <!-- Ready To Grade -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardReady"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ready To Grade?"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Place peanut kernels inside the imaging chamber."
                        android:textColor="@color/text_gray"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartScan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Start Scan"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        app:backgroundTint="@color/brand_primary"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.50" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav" />

</LinearLayout>
