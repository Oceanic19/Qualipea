<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream_bg">

    <include layout="@layout/header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spanish Peanut Quality Grading"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <!-- Raspberry Pi status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/circle_gray"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvDeviceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking Raspberry Pi…"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Your Activity -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Activity"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- Statistics -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_stat_tile"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total scans"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStatScans"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/brand_primary"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_stat_tile"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kernels analyzed"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStatKernels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/brand_primary"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Kernel Quality -->
                    <LinearLayout
                        android:id="@+id/activityBreakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Kernel Quality"
                                android:textColor="@color/text_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All scans"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_bar_track"
                            android:clipToOutline="true"
                            android:layout_marginTop="10dp">

                            <View
                                android:id="@+id/barGood"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@color/status_good" />

                            <View
                                android:id="@+id/barDefect"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@color/delete_red" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:id="@+id/dotGood"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/dot_good"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:id="@+id/tvLegendGood"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_dark"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical|end">

                                <View
                                    android:id="@+id/dotDefect"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/dot_defect"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:id="@+id/tvLegendDefect"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_dark"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Peanut Quality Reference Guide -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardReferenceGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peanut Classes Reference Guide"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap a class below to view its sample appearances and description."
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp" />

                    <!-- EXTRA CLASS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_tile"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:id="@+id/rowExtraHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Extra Class"
                                android:textColor="@color/text_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvExtraArrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⌄"
                                android:textColor="@color/brand_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutExtraContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnExtraPrev"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="48dp"
                                    android:minHeight="48dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="‹"
                                    android:textSize="28sp"
                                    android:textColor="@color/brand_primary"
                                    app:backgroundTint="@android:color/transparent"
                                    app:cornerRadius="24dp"
                                    app:elevation="0dp" />

                                <ImageView
                                    android:id="@+id/ivExtraClass"
                                    android:layout_width="0dp"
                                    android:layout_height="160dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/logo_peanut"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="Extra Class sample image. Tap to zoom." />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnExtraNext"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="48dp"
                                    android:minHeight="48dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="›"
                                    android:textSize="28sp"
                                    android:textColor="@color/brand_primary"
                                    app:backgroundTint="@android:color/transparent"
                                    app:cornerRadius="24dp"
                                    app:elevation="0dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvExtraCounter"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="1/4"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvExtraDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Extra Class generally represents kernels with very good overall appearance, uniformity, and minimal visible defects."
                                android:textColor="@color/text_gray"
                                android:textSize="13sp"
                                android:lineSpacingExtra="3dp"
                                android:layout_marginTop="12dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- CLASS I -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_tile"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:id="@+id/rowClassOneHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Class I"
                                android:textColor="@color/text_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvClassOneArrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⌄"
                                android:textColor="@color/brand_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutClassOneContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnClassOnePrev"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="48dp"
                                    android:minHeight="48dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="‹"
                                    android:textSize="28sp"
                                    android:textColor="@color/brand_primary"
                                    app:backgroundTint="@android:color/transparent"
                                    app:cornerRadius="24dp"
                                    app:elevation="0dp" />

                                <ImageView
                                    android:id="@+id/ivClassOne"
                                    android:layout_width="0dp"
                                    android:layout_height="160dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/broken_kernel"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="Class I sample image. Tap to zoom." />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnClassOneNext"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="48dp"
                                    android:minHeight="48dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="›"
                                    android:textSize="28sp"
                                    android:textColor="@color/brand_primary"
                                    app:backgroundTint="@android:color/transparent"
                                    app:cornerRadius="24dp"
                                    app:elevation="0dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvClassOneCounter"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="1/4"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvClassOneDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Class I generally represents good-quality kernels with acceptable appearance and only limited minor imperfections."
                                android:textColor="@color/text_gray"
                                android:textSize="13sp"
                                android:lineSpacingExtra="3dp"
                                android:layout_marginTop="12dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- CLASS II -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_tile"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:id="@+id/rowClassTwoHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Class II"
                                android:textColor="@color/text_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvClassTwoArrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⌄"
                                android:textColor="@color/brand_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutClassTwoContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnClassTwoPrev"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="48dp"
                                    android:minHeight="48dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="‹"
                                    android:textSize="28sp"
                                    android:textColor="@color/brand_primary"
                                    app:backgroundTint="@android:color/transparent"
                                    app:cornerRadius="24dp"
                                    app:elevation="0dp" />

                                <ImageView
                                    android:id="@+id/ivClassTwo"
                                    android:layout_width="0dp"
                                    android:layout_height="160dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/discolored_kernel"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="Class II sample image. Tap to zoom." />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnClassTwoNext"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="48dp"
                                    android:minHeight="48dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="›"
                                    android:textSize="28sp"
                                    android:textColor="@color/brand_primary"
                                    app:backgroundTint="@android:color/transparent"
                                    app:cornerRadius="24dp"
                                    app:elevation="0dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvClassTwoCounter"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="1/4"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvClassTwoDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Class II generally allows a wider range of appearance variations and imperfections than the higher classes, within applicable limits."
                                android:textColor="@color/text_gray"
                                android:textSize="13sp"
                                android:lineSpacingExtra="3dp"
                                android:layout_marginTop="12dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- DEFECTED -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_tile">

                        <LinearLayout
                            android:id="@+id/rowDefectedHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Defected"
                                android:textColor="@color/text_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDefectedArrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⌄"
                                android:textColor="@color/brand_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutDefectedContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDefectedPrev"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="48dp"
                                    android:minHeight="48dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="‹"
                                    android:textSize="28sp"
                                    android:textColor="@color/brand_primary"
                                    app:backgroundTint="@android:color/transparent"
                                    app:cornerRadius="24dp"
                                    app:elevation="0dp" />

                                <ImageView
                                    android:id="@+id/ivDefected"
                                    android:layout_width="0dp"
                                    android:layout_height="160dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/defect_moldy"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="Defected sample image. Tap to zoom." />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDefectedNext"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:minWidth="48dp"
                                    android:minHeight="48dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="›"
                                    android:textSize="28sp"
                                    android:textColor="@color/brand_primary"
                                    app:backgroundTint="@android:color/transparent"
                                    app:cornerRadius="24dp"
                                    app:elevation="0dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvDefectedCounter"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="1/4"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvDefectedDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Defected is an additional category used by the QualiPea application for kernels showing visible damage, mold, insect activity, or other serious defects. It is not an official PNS class."
                                android:textColor="@color/text_gray"
                                android:textSize="13sp"
                                android:lineSpacingExtra="3dp"
                                android:layout_marginTop="12dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Note: Images are illustrative placeholders, not official grading reference images. Actual grading depends on the applicable quality requirements."
                        android:textColor="@color/text_gray"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.35" />

            <!-- Recent Activity -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToOutline="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Activity"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="2dp" />

                    <FrameLayout
                        android:id="@+id/recentBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp">

                        <LinearLayout
                            android:id="@+id/recentScansContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/emptyRecent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:text="No recent activity yet.\nYour scans will show up here."
                            android:textColor="@color/text_gray"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAllHistory"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="View all history"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconGravity="textEnd"
                        app:iconTint="@color/brand_primary"
                        android:visibility="invisible" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.75" />

            <!-- Ready To Grade -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardReady"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ready To Grade?"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Place peanut kernels inside the imaging chamber."
                        android:textColor="@color/text_gray"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartScan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Start Scan"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        app:backgroundTint="@color/brand_primary"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.50" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav" />

</LinearLayout>
