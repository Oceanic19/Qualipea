<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/card_white"
    android:elevation="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/navHomeItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_home"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:focusable="false"
            app:tint="@color/nav_inactive" />

        <TextView
            android:id="@+id/navHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textSize="11sp"
            android:textColor="@color/nav_inactive"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navScanItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageButton
            android:id="@+id/navSearch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_scan"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:focusable="false"
            app:tint="@color/nav_inactive" />

        <TextView
            android:id="@+id/navScanLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan"
            android:textSize="11sp"
            android:textColor="@color/nav_inactive"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navHistoryItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageButton
            android:id="@+id/navHistory"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_history"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:focusable="false"
            app:tint="@color/nav_inactive" />

        <TextView
            android:id="@+id/navHistoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="History"
            android:textSize="11sp"
            android:textColor="@color/nav_inactive"
            android:layout_marginTop="3dp" />
    </LinearLayout>

</LinearLayout>
